# Copy to .env.local for local runs; on Vercel set these under Project -> Settings -> Environment Variables.
# NEVER commit real values. The client secret is created in Entra ID -> App registrations ->
# App_Dynatech_tpsqlscript_send_as -> Certificates & secrets.

# --- Service principal (App_Dynatech_tpsqlscript_send_as) ---
# Deliberately NOT named AZURE_*: machine-wide AZURE_TENANT_ID / AZURE_CLIENT_ID / AZURE_CLIENT_SECRET (set by other
# tools) override .env.local and made the app sign in as a different app registration.

RECON_TENANT_ID=a88a9022-7c1c-4daf-a188-ffb1564574f7
RECON_CLIENT_ID=a25cb75b-c576-45b2-bfa4-057410a4bdc9
RECON_CLIENT_SECRET=

# --- Fabric Warehouse (dbo.bank_recon_*) ---
WAREHOUSE_SERVER=ekiivka4psxu3imi76yvmrlu64-d7l5gildyy4eddbcmdniifv4iy.datawarehouse.fabric.microsoft.com
WAREHOUSE_DATABASE=

# --- Fabric Lakehouse SQL analytics endpoint (proddta JDE tables) ---
# Lakehouse -> SQL analytics endpoint -> Settings -> SQL connection string
LAKEHOUSE_SERVER=
LAKEHOUSE_DATABASE=

# --- Access to this app (HTTP Basic auth). Required - the app shows client financial data. ---
APP_USERNAME=
APP_PASSWORD=
